QT += widgets
CONFIG += c++11 plugin no_plugin_name_prefix
TEMPLATE = lib

DEFINES += PLUGIN_NAME=\\\"{{PLUGIN_NAME}}\\\"
#开启日志模块
DEFINES += LOG_MIN_FILE_LEVEL=XPLUGIN_LOG_LEVEL_DEBUG

INCLUDEPATH += $$PWD/include $$PWD/src

win32 {
    LIBS += -L$$PWD/lib/windows -lxplugin
}

unix:!macx {
    LIBS += -L$$PWD/lib/aarch64 -l:xplugin.so
}

HEADERS += src/{{PLUGIN_NAME_PASCAL}}.h
SOURCES += src/{{PLUGIN_NAME_PASCAL}}.cpp
